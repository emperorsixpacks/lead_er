# ── Core ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://leads:leads@postgres:5432/leads
API_SECRET=change-me-to-a-long-random-string

# ── Tracking (Cloudflare Worker → FastAPI) ────────────────────────────
# Subdomain you point at the Worker, e.g. t.yourdomain.com
TRACKING_BASE_URL=https://t.yourdomain.com
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=your-long-random-topic-name

# ── Discover ──────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
# Comma-separated categories / queries to search per city
TARGET_CATEGORIES=plumbers,roofers,hvac,landscapers
# Comma-separated city,state strings
TARGET_CITIES=Austin TX,Denver CO
TARGET_COUNTRY=US

# ── Enrich / Verify / Personalize ─────────────────────────────────────
ZEROBOUNCE_API_KEY=
MILLIONVERIFIER_API_KEY=
# Local testing: EMAIL_VERIFY_MOCK=true returns deterministic results (no API call)
EMAIL_VERIFY_MOCK=false
# OpenAI-compatible endpoint. For a local Ollama model, use the line below
# and leave LLM_API_KEY empty (Ollama needs no key).
LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gemma4:31b-cloud

# ── Sending (Gmail SMTP via app password) ─────────────────────────────
# Gmail app password (NOT your account password): enable 2-Step Verification
# then create one at https://myaccount.google.com/apppasswords
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=you@gmail.com
GMAIL_SMTP_PASSWORD=your-16-char-app-password
# Hard daily cap on sends (Gmail free ≈ 500/day, start much lower)
DAILY_SEND_CAP=30
SENDER_COMPANY=Your Company
SENDER_ADDRESS=123 Main St, City, State ZIP
