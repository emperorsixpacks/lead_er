# ============================================================
#  lead_er — environment configuration
#  Copy to `.env` (git-ignored) and fill in the blanks.
# ============================================================

# ── Core ──────────────────────────────────────────────────────────────
# Local docker-compose default, or your Render "Internal Database URL".
DATABASE_URL=postgresql+asyncpg://leads:leads@postgres:5432/leads
# MUST match the API_SECRET you set on the Cloudflare Worker.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET=change-me

# ── Tracking (Cloudflare Worker -> FastAPI -> ntfy) ────────────────────
# Subdomain pointing at the Worker (e.g. t.yourdomain.com). Never use *.workers.dev.
TRACKING_BASE_URL=https://t.yourdomain.com
NTFY_URL=https://ntfy.sh
# Long random topic name; subscribe your phone's ntfy app to it.
NTFY_TOPIC=change-me

# ── Discover ──────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
# Comma-separated categories / queries searched per city.
TARGET_CATEGORIES=plumbers,roofers,hvac,landscapers
# Comma-separated "City State" strings.
TARGET_CITIES=Austin TX,Denver CO
TARGET_COUNTRY=US

# ── Enrich / Verify / Personalize ─────────────────────────────────────
MILLIONVERIFIER_API_KEY=
# true = deterministic local results (no API call, no cost). Testing only.
EMAIL_VERIFY_MOCK=false
# OpenAI-compatible endpoint. For local Ollama use the second line + empty key.
LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gemma4:31b-cloud        # free Ollama cloud model

# ── Sending (Gmail SMTP via app password) ─────────────────────────────
# Enable 2-Step Verification, then create an app password (NOT your login
# password) at https://myaccount.google.com/apppasswords
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=you@gmail.com
GMAIL_SMTP_PASSWORD=your-16-char-app-password
# Start low: free Gmail caps ~500/day and cold sends get flagged if you go fast.
DAILY_SEND_CAP=30
# BCC yourself a copy of every send.
SEND_BCC_EMAIL=you@gmail.com
# Email copy: signoff name + optional links (empty = omitted).
SENDER_NAME=Your Name
EMAIL_VALUE_PROP=
EMAIL_DEMO_URL=
EMAIL_BOOKING_URL=
EMAIL_LINKEDIN_URL=
EMAIL_CTA=Would you be open to a quick 15-minute chat?
# CAN-SPAM: physical mailing address + sender name shown in every email.
SENDER_COMPANY=Your Company
SENDER_ADDRESS=123 Main St, City, State ZIP
